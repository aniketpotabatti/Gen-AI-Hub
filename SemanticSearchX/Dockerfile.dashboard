# Standalone image for the SemanticSearchX Streamlit dashboard.
# The UI talks to the API over HTTP, so it needs only the dashboard dependencies
# (no Torch / FAISS / Qdrant).
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY dashboard/requirements.txt ./dashboard/requirements.txt
RUN pip install --no-cache-dir -r dashboard/requirements.txt

COPY dashboard ./dashboard

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')" || exit 1

CMD ["streamlit", "run", "dashboard/streamlit_app.py", \
     "--server.port", "8501", "--server.address", "0.0.0.0"]
