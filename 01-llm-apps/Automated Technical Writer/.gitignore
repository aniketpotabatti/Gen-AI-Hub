# .gitignore for Automated Technical Writer

# Environment variables and secrets
.env
.env.*
*.pem

# Python cache and environment folders
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
.eggs/
.cache/
dist/
build/
.venv/
venv/
env/

# Lint/cache folders
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Logs and coverage
*.log
coverage/
htmlcov/
.coverage
.tox/

# Editor/IDE/project files
.vscode/
.idea/
*.swp
*.swo

# OS-specific/junk files
.DS_Store
Thumbs.db
desktop.ini

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Node/JS (for doc playground etc.)
node_modules/

# Local user config
/*.local/