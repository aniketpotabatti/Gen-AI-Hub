# ─────────────────────────────────────────────
# Automated Technical Writer — .gitignore
# ─────────────────────────────────────────────

# ── Secrets / Environment ─────────────────────
.env
.env.local
.env.*.local
*.pem

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
*.pyc

# ── Ruff / linting cache ──────────────────────
.ruff_cache/

# ── Node / Frontend ───────────────────────────
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions
frontend/next-env.d.ts
frontend/*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Database / Runtime files ──────────────────
*.db
*.sqlite
*.sqlite3

# ── OS files ──────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE / Editor ──────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Docker volumes / data ─────────────────────
postgres_data/

# ── Misc ──────────────────────────────────────
*.log
.vercel
coverage/
another_plan.md
processor.py
